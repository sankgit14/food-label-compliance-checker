# Local deterministic tool-using agent mode works without a model account.
MODEL_BACKEND=stub
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_BREAKER_THRESHOLD=3
MODEL_BREAKER_RESET_SECONDS=30
MODEL_INPUT_COST_PER_1M=
MODEL_OUTPUT_COST_PER_1M=
STUB_DELAY_SECONDS=0

AGENT_MAX_STEPS=20
AGENT_MAX_TOOL_CALLS=32
AGENT_MAX_RUN_SECONDS=120
WORKER_POLL_SECONDS=1
REVIEWS_PER_CLIENT_PER_MINUTE=20
LOCUST_USERS=5
LOCUST_SPAWN_RATE=1
LOG_LEVEL=INFO

# Defaults are local paths and are ignored by Git.
REVIEW_DB_PATH=data/state/review_runs.sqlite3
QUARANTINE_FILE=data/quarantine/rejected_records.jsonl
